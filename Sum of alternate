#include<iostream>
using namespace std;
void swap(int &a,int &b)
{
	int temp=a;
	a=b;
	b=temp;
}

void selectionSort(int a[],int n)
{
	for(int i=0;i<n-1;i++)
	{
		int min=i;
		for(int j=i+1;j<n;j++)
		{
			if(a[j]<a[min])
			swap(a[j],a[min]);
			
		}
	}
}
void print(int a[],int n)
{
	int sum=0;
	for(int i=0;i<n;i++)
	{
	if(i%2==0)
	{
		sum+=a[i];
	}
	//	cout<<a[i]<<"  ";
		
	}
	cout<<"Sum of alternate elements:"<<sum;
	cout<<endl;
	
}
int main()
{
	int a[4]={3,5,1,2};
	selectionSort(a,4);
	print(a,4);
	return 0;
}
